# Everything here is regenerable. Tracking it means every re-run produces a
# diff on binary files and the repo grows with each experiment.
#
# What stays tracked: scripts, READMEs, and data/split_meta.json (which records
# the exact filter/split/feature choices, so a split can be reproduced without
# shipping the data itself).

# Raw + derived datasets — downloaded by prepare_data.py, rebuilt by it.
# Ignore the whole data dir and re-admit only the small *_meta.json files, so a
# new dataset's format (.tar.bz2, .jsonlist.bz2, .sqlite, ...) can never slip
# through by not matching an extension listed here.
*/data/*
!*/data/*meta*.json

# Metrics and per-row predictions — rebuilt by baselines.py / run_*.py
*/results/

# Per-run model artifacts (policies.parquet, lr.joblib, report.md, checkpoints)
*/run*/
*/rrf*/
*/smoke/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json
